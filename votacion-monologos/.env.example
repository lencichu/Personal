# Copia este archivo a ".env" y rellena tus propios valores antes de arrancar el servidor.

# Puerto en el que escucha el servidor.
PORT=3000

# "production" activa cookies solo-HTTPS. Usa "development" si pruebas en local sin HTTPS.
NODE_ENV=production

# Cadena larga y aleatoria usada para firmar las sesiones del administrador.
# Genérala, por ejemplo, con: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Código que hace falta para poder registrar la cuenta del administrador.
# Solo tú debes conocerlo. Una vez creada la cuenta, puedes rotarlo o dejarlo.
ADMIN_SETUP_TOKEN=cambia-esto-tambien-antes-de-registrar-el-admin
